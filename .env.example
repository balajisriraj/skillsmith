# Claude (default). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
SKILLSMITH_LLM=anthropic
SKILLSMITH_MODEL=claude-opus-5-5
SKILLSMITH_MAX_ROUNDS=3

# Upload the forged skill to the Skills API and run a prompt with it mounted (uses your workspace; deleted after).
SKILLSMITH_LIVE_RUNS=false

# Run with no API key: a deterministic model that interviews, drafts and tests with simple heuristics.
# SKILLSMITH_LLM=scripted
# SKILLSMITH_SCRIPTED_DELAY=25
